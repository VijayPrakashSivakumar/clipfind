# ClipFind backend environment variables
# Copy this file to .env and fill in real values before running the backend.

# Port the backend listens on (content script defaults to http://localhost:4000)
PORT=4000

# Optional: base URL the extension uses to reach the backend
CLIPFIND_BACKEND_URL=http://localhost:4000

# Optional AI provider keys (Phase 2+ intelligent transcript analysis).
# Never commit real keys. The extension never sends API keys to YouTube.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: default AI model for transcript analysis
CLIPFIND_AI_MODEL=gpt-4o-mini
